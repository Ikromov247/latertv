{
  "name": "later-tv",
  "version": "0.1.0",
  "description": "Turn your YouTube backlog into live, unskippable TV channels.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --no-warnings 'src/**/*.test.ts'",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@types/node": "^24.19.1",
    "@types/youtube": "^0.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.ikromov247.latertv",
    "productName": "Later TV",
    "files": [
      "out/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  }
}
